{
  "name": "puzzleme",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @puzzleme/game web",
    "web": "pnpm dev",
    "export:web": "pnpm --filter @puzzleme/game export:web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "ios": "pnpm --filter @puzzleme/game ios",
    "lint": "eslint . --max-warnings 0",
    "check:dependencies": "pnpm --filter @puzzleme/game exec expo install --check",
    "test:automation": "node --test .github/scripts/*-tests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "~19.2.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^4.0.0"
  }
}
